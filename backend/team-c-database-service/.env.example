# Copy this file to .env and edit.  NEVER commit .env
PORT=4000
# The service key you give to Team D. Make it long and random, e.g.  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SERVICE_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=HospitalAppointmentDB

# Appointment slot length (minutes) used when Team D does not send start/end,
# and the UTC hour at which the first slot of the day starts.
SLOT_MINUTES=10
DAY_START_HOUR_UTC=9

# Development only: lets Team D's "reset data" button also clear appointments here. Keep false in production.
ALLOW_DEV_RESET=true
# Requests per minute allowed per client IP (0 = off). Set 0 while running the load test.
RATE_LIMIT_PER_MIN=3000
